{
  "max_file_lines": 300,
  "max_function_lines": 50,
  "max_nesting_depth": 4,
  "max_parameters": 5,
  "max_comment_lines": 5,
  "max_doc_comment_lines": 50,
  "max_types_per_file": 2,
  "include_extensions": [
    ".go",
    ".py",
    ".rs",
    ".swift"
  ],
  "ignore": [
    ".ci-gates",
    ".git",
    ".build",
    ".venv",
    "DerivedData",
    "bin",
    "build",
    "coverage",
    "dist",
    "node_modules",
    "out",
    "target",
    "vendor",
    "*.generated.*",
    "*.g.swift",
    "tests/fixtures"
  ],
  "language_overrides": {}
}
