{
  "max_file_lines": 600,
  "max_function_lines": 80,
  "max_nesting_depth": 8,
  "max_parameters": 20,
  "max_comment_lines": 25,
  "max_types_per_file": 5,
  "include_extensions": [
    ".go",
    ".py",
    ".rs",
    ".swift"
  ],
  "ignore": [
    ".ci-gates",
    ".git",
    ".build",
    ".venv",
    "DerivedData",
    "bin",
    "build",
    "coverage",
    "dist",
    "node_modules",
    "out",
    "target",
    "vendor",
    "*.generated.*",
    "*.g.swift",
    "tests/fixtures"
  ],
  "language_overrides": {}
}
